---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BaseContact, { getContactTranslations } from '../../components/pages/BaseContact.astro';
import type { SupportedLanguage } from '../../types/i18n';

const pageTitle = 'Contatti';

const language: SupportedLanguage = 'it';

const t = getContactTranslations(language);

const pageDescription = t.pageDescription;

const i18nData = {
    currentLang: language,
};

export const prerender = true;
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} i18nData={i18nData}>
    <BaseContact language={language} />
</BaseLayout>
