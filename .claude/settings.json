{
  "permissions": {
    "allow": [
      "Bash(grep -oE \"^[^ ]+\\\\.\\(ts|astro\\):[0-9]+:[0-9]+ - error[^$]*\")",
      "Bash(git commit *)",
      "Bash(gh auth *)",
      "Bash(npx skills *)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/complexity-gate.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
