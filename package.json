{
  "name": "aleromano.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "predocker:build": "npm test",
    "docker:build": "docker build -t aleromano.com .",
    "docker:clean": "docker compose down --remove-orphans",
    "docker:dev": "npm run docker:clean && docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:obs": "npm run docker:clean && docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile observability up --build",
    "db:seed": "node scripts/seed-analytics.mjs",
    "load:smoke": "node scripts/load-test.mjs smoke",
    "load:test": "node scripts/load-test.mjs load",
    "load:stress": "node scripts/load-test.mjs stress",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "complexity": "cccc src scripts observability > /dev/null && echo 'cccc: complexity gate passed'",
    "test:watch": "vitest",
    "postinstall": "node -e \"if (process.env.CI || process.env.GEOIP_DOWNLOAD === '0') { process.exit(0); } import('geolite2-redist').then(g => g.downloadDbs())\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/node": "^11.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "astro": "^7.3.6",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "chartjs-chart-geo": "^4.3.6",
    "cookie": "^2.0.1",
    "es-module-lexer": "^3.0.3",
    "geolite2-redist": "^3.1.3",
    "marked": "^18.1.0",
    "maxmind": "^5.0.7",
    "nodemailer": "^10.0.15",
    "rehype-external-links": "^3.0.0",
    "reveal.js": "^6.0.2",
    "shiki": "^4.5.0",
    "turndown": "^7.2.4",
    "typescript": "7.1.0-dev.20261008.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tybys/wasm-util": "^0.10.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autocannon": "^8.0.0",
    "fast-check": "^4.10.2",
    "msw": "^3.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3": false
  },
  "overrides": {
    "msw": {
      "typescript": "$typescript"
    }
  }
}
